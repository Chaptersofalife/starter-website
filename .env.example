# Copy this file to ".env.local" and fill in the real values.
# .env.local is private: it is never uploaded to GitHub.
# Add the same values on Netlify under: Site configuration > Environment variables.

# --- Supabase (logins, database, photo storage) ---
# Found in Supabase: Project Settings > API Keys (and Data API for the URL).
# The URL looks like https://<project-id>.supabase.co (not the dashboard link).
# The publishable key starts with sb_publishable_ and is safe to use in the browser.
# Never put the secret key (sb_secret_...) here or anywhere starting NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stripe (payments) ---
# Found in Stripe: Developers > API keys. Use the "test" keys while building.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
